# Public URLs used by Docker Compose and local development.
APP_PORT=8080
BASE_URL=http://localhost:8080/api
OHIF_PUBLIC_URL=http://localhost:8080/viewer

# Frontend build/runtime public configuration.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_OHIF_BASE_URL=http://localhost:8080/viewer

# Database.
POSTGRES_USER=dicom_admin
POSTGRES_PASSWORD=pass123
POSTGRES_DB=dicomdb
DATABASE_URL=postgresql+asyncpg://dicom_admin:pass123@postgres:5432/dicomdb

# Backend runtime.
PERSISTENT_OUTPUT_DIR=/app/persistent_output
OHIF_VIEWER_DIR=/app/ohif
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:3000
CORS_ERROR_ORIGIN=http://localhost:8080
JWT_SECRET_KEY=change-me-before-production
JWT_EXPIRATION_MINUTES=60
API_KEYS=

# DICOM archive integration.
DICOM_ARCHIVE_ENABLED=true
DICOM_ARCHIVE_DICOMWEB_URL=http://orthanc:8042/dicom-web
DICOM_ARCHIVE_STOW_URL=http://orthanc:8042/dicom-web/studies
